# 复制为 .env 后填写；.env 已被 .gitignore 忽略，不要提交。
# 登录密码没有默认值；只有 real.login / npm run spike 需要。
BROWSER_PASSWORD=

# 服务
BROWSER_API_HOST=127.0.0.1
BROWSER_API_PORT=4320
BROWSER_ARTIFACTS_DIR=artifacts
BROWSER_WORKER_CONCURRENCY=2
BROWSER_LOG_TO_FILE=true

# 持久化：auto = 有 DSN 且连得上用 Postgres，否则文件回落
BROWSER_STORAGE_DRIVER=auto
BROWSER_AGENT_PG_DSN=
BROWSER_PERSISTENCE_DIR=artifacts/persistence

# 浏览器
BROWSER_CHANNEL=chromium
BROWSER_HEADLESS=true
# CLI 主流程默认目标：real = 真实商品页；fixture = 离线靶场
BROWSER_DEFAULT_TARGET=real
BROWSER_ACTION_TIMEOUT_MS=30000
BROWSER_EXPECT_TIMEOUT_MS=10000

# 域名白名单（逗号分隔）；默认 localhost,127.0.0.1
BROWSER_ALLOWED_HOSTS=localhost,127.0.0.1
# BROWSER_REMOTE_HOST=192.168.0.121

# 真实前端 / 本地靶场
BROWSER_WEB_URL=http://localhost:3000
BROWSER_USERNAME=admin
BROWSER_TENANT_ID=019a0aee-0000-7000-8000-000000000002
BROWSER_TENANT_CODE=default
BROWSER_FIXTURE_PORT=4310

# 文件上传：只能上传该目录内的文件；扩展名 / 大小在上传前校验
BROWSER_UPLOAD_ROOT=artifacts/uploads
BROWSER_UPLOAD_ALLOWED_EXTENSIONS=.txt,.csv,.json,.png,.jpg,.pdf
BROWSER_UPLOAD_MAX_BYTES=5242880

# 文件下载：落盘到 artifacts/tasks/<taskId>/downloads
BROWSER_DOWNLOAD_ALLOWED_EXTENSIONS=.txt,.csv,.json,.png,.jpg,.pdf,.zip
BROWSER_DOWNLOAD_MAX_BYTES=10485760

# 兼容旧 spike 的变量名（BROWSER_* 优先）
# SPIKE_PASSWORD=
# SPIKE_USERNAME=admin
# SPIKE_TENANT_ID=
# SPIKE_WEB_URL=http://localhost:3000
# SPIKE_FIXTURE_PORT=4310
# SPIKE_ALLOWED_HOSTS=localhost,127.0.0.1
# SPIKE_BROWSER_CHANNEL=
# SPIKE_APPROVAL=allow
